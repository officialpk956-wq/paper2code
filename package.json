{
  "name": "paper2code",
  "version": "2.0.0",
  "description": "AI Engineering Learning Ecosystem",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/copy-monaco-assets.mjs",
    "prebuild": "node scripts/generate-content-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "generate:content": "node scripts/generate-content-index.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.0.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@next/mdx": "^16.2.9",
    "@types/katex": "^0.16.8",
    "@xyflow/react": "^12.0.0",
    "clsx": "^2.0.0",
    "framer-motion": "^11.15.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.469.0",
    "next": "^15.0.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.3.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.2.0",
    "three": "^0.170.0",
    "unified": "^11.0.5",
    "zod": "^3.24.0"
