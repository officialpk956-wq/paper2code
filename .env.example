# ── Backend (FastAPI) ─────────────────────────────────────────────────────────

# PostgreSQL — required in production (never use SQLite in production)
DATABASE_URL="postgresql+psycopg2://p2c:p2cdev@localhost:5432/p2c"

# JWT signing secret — REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""

# AI providers
GROQ_API_KEY=""                       # Required for paper → code generation
HF_API_KEY=""                         # Optional — HuggingFace

# Code execution sandbox (Piston — self-hosted via docker-compose)
PISTON_URL="http://localhost:2000"

# Task queue (Celery + Redis)
REDIS_URL="redis://localhost:6379/0"

# Environment flag — set to "production" on deployed servers
ENVIRONMENT="development"

# Comma-separated origins for production. Use * for local dev only.
# Example: CORS_ORIGINS=https://paper2code.com,https://www.paper2code.com
CORS_ORIGINS=*

# Content Security Policy (enforced in production by startup validation)
# Example: CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://paper2code-1-81y5.onrender.com https://observablehq.com https://us.i.posthog.com; frame-ancestors 'none';"
CONTENT_SECURITY_POLICY=""

# Observability (optional)
SENTRY_DSN=""

# Resend Email Configuration
RESEND_API_KEY=           # Get free key at resend.com (3k emails/month free)
EMAIL_FROM=Paper2Code <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:3000   # Set to prod URL in production

# Cloudflare R2 Object Storage (optional — falls back to local tempfile if unset)
R2_ACCOUNT_ID=            # From R2 dashboard → Account ID
R2_ACCESS_KEY_ID=         # R2 API token → Access Key ID
R2_SECRET_ACCESS_KEY=     # R2 API token → Secret Access Key
R2_BUCKET_NAME=           # e.g. paper2code-pdfs
R2_PUBLIC_URL=            # Optional: public bucket URL for direct downloads (CDN edge cache)

# Storage quota (per user, 0 = unlimited)
STORAGE_QUOTA_MB=500      # Free tier: 500 MB. Set 0 for unlimited.

# Tutor session config
TUTOR_DAILY_LIMIT=30      # Max tutor queries per user per day (free tier)

# Usage quotas (0 = unlimited)
PAPER_MONTHLY_LIMIT=0     # Max papers per user per calendar month (free tier: 3)
ZOMBIE_THRESHOLD_HOURS=2  # Hours before a stuck "running" task is force-failed

# Data retention (Celery Beat cleanup tasks)
TUTOR_SESSION_RETENTION_DAYS=90    # Delete tutor session records older than N days (Tue 02:00 UTC)
XP_EVENT_RETENTION_DAYS=365        # Delete XP event audit rows older than N days (2nd of month 01:00 UTC)

# ── OAuth Providers (Sprint D) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=          # From Google Cloud Console → OAuth 2.0 credentials
GOOGLE_CLIENT_SECRET=      # From Google Cloud Console → OAuth 2.0 credentials
GITHUB_CLIENT_ID=          # From GitHub → Settings → Developer Settings → OAuth Apps
GITHUB_CLIENT_SECRET=      # From GitHub → Settings → Developer Settings → OAuth Apps

# ── PostHog Analytics (Sprint D) ─────────────────────────────────────────────
POSTHOG_API_KEY=           # From PostHog project settings (phc_...)
POSTHOG_HOST=https://app.posthog.com   # Override for EU region: https://eu.posthog.com

# ── Observability & Alerting ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=        # Incoming webhook for 5xx alerts (from Slack App settings)
SLACK_ALERT_COOLDOWN_SECONDS=60   # Dedupe window: don't re-alert the same route within N seconds
SENTRY_TRACES_SAMPLE_RATE=0.05    # % of requests to trace (0.0–1.0). Keep ≤0.1 in production.
SENTRY_PROFILES_SAMPLE_RATE=0.01  # % of traced requests to profile. Keep low — high CPU overhead.
APP_VERSION=              # Optional: git SHA or semver tag — shown in Sentry for release tracking

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
OPENAI_API_KEY=""
